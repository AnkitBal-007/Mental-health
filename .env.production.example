# =============================================================================
# MindGuard — Cloud Production Environment Variables Template
#
# Platforms: Supabase (PostgreSQL) + Render/Railway (Backend & ML) + Vercel (Frontend)
#
# INSTRUCTIONS:
# Copy the relevant variables below into the Environment Variables settings of
# each respective platform's dashboard. Do NOT commit real secrets to Git.
# =============================================================================


# =============================================================================
# 1. SUPABASE (Managed PostgreSQL Database)
# =============================================================================
# Where to get: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Note: Ensure you replace [YOUR-PASSWORD] with your actual database password.
# Use the direct connection URI or session pooler URI (both supported).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres


# =============================================================================
# 2. RENDER / RAILWAY — BACKEND SERVICE (FastAPI Core Service)
# =============================================================================
# Database connection string copied directly from your Supabase Dashboard
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Secret key used for signing and verifying JWT tokens (Generate via: openssl rand -hex 32)
JWT_SECRET=generate_with_openssl_rand_hex_32_and_paste_here

# Comma-separated list of allowed frontend domains (Where to get: Your deployed Vercel frontend URL)
ALLOWED_ORIGINS=https://your-mindguard-app.vercel.app,http://localhost:3000

# Public or internal URL of your deployed ML Pipeline service (Where to get: Render/Railway ML service URL)
ML_PIPELINE_URL=https://mindguard-ml.onrender.com

# Temporary secret token to trigger POST /admin/seed-demo-data (Generate via: openssl rand -hex 16)
ADMIN_SEED_TOKEN=generate_temporary_secret_token_for_seeding_here

# JWT token expiration in minutes (Optional: defaults to 1440 mins = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# JWT signing algorithm (Optional: defaults to HS256)
JWT_ALGORITHM=HS256


# =============================================================================
# 3. RENDER / RAILWAY — ML PIPELINE SERVICE (FastAPI ML & AI Service)
# =============================================================================
# Comma-separated list of allowed frontend & backend domains (Where to get: Vercel frontend URL + Render backend URL)
ALLOWED_ORIGINS=https://your-mindguard-app.vercel.app,https://your-mindguard-backend.onrender.com,http://localhost:3000

# Google Gemini API Key for Saheli conversational AI (Where to get: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_from_google_ai_studio

# Gemini model identifier (Where to get: Google AI Studio model list, defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face Access Token (Optional: only needed if downloading gated model checkpoints from https://huggingface.co/settings/tokens)
# HUGGINGFACE_TOKEN=hf_your_token_here


# =============================================================================
# 4. VERCEL — FRONTEND APPLICATION (React + Vite SPA)
# =============================================================================
# Public URL of your deployed Backend API service (Where to get: Render or Railway Backend service URL)
VITE_BACKEND_URL=https://your-mindguard-backend.onrender.com

# Public URL of your deployed ML Pipeline service (Where to get: Render or Railway ML service URL)
VITE_ML_URL=https://mindguard-ml.onrender.com


# =============================================================================
# 5. POST-DEPLOYMENT DEMO DATA SEEDING (One-Time Execution)
# =============================================================================
# Once the backend and Supabase are deployed, seed the initial users and victim data by running:
#
# curl -X POST https://your-mindguard-backend.onrender.com/admin/seed-demo-data \
#      -H "X-Admin-Seed-Token: <YOUR_ADMIN_SEED_TOKEN>"
#
# Seeded Demo Accounts (Password: 'password123'):
#   - National Admin: national_admin
#   - State Admin:    state_bihar
#   - District Officer: district_patna
#   - Counsellor:     counsellor_priya
# =============================================================================
