# Backend Service Environment Variables
# Copy to .env or configure in Render/Railway dashboard

# Database connection (PostgreSQL on Supabase or SQLite for local dev)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT Secret for authentication tokens (Generate via: openssl rand -hex 32)
JWT_SECRET=your_secure_random_jwt_secret_here

# CORS Allowed Origins (Comma-separated frontend URLs, e.g. Vercel deployment)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ML Pipeline Service Address
ML_PIPELINE_URL=http://localhost:8001

# Temporary Admin Seed Token for POST /admin/seed-demo-data (Generate via: openssl rand -hex 16)
ADMIN_SEED_TOKEN=your_admin_seed_token_here

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Alert Thresholds
DISTRESS_ALERT_THRESHOLD=70.0
ESCALATION_PROB_THRESHOLD=0.60

# Server
BACKEND_HOST=0.0.0.0
PORT=8000
